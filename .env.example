

# --- Postgres (primary relational store: orgs, users, tickets, billing) ---
# --- Neon PostgreSQL ---
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=password
POSTGRES_DB=neondb
DATABASE_URL="database_url"

# --- MongoDB (unstructured: chat transcripts, activity logs, attachments meta) ---
MONGO_USER=surajkumar854000_db_user
MONGO_PASSWORD=password
MONGO_DB=support_saas_docs

MONGO_URL="mongo_url"


# --- Redis (cache, sessions, BullMQ job queues, rate limiting) ---
REDIS_PASSWORD=saas_dev_password
REDIS_URL=redis://:saas_dev_password@localhost:6379

# --- Elasticsearch (full-text ticket/article search) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Qdrant (vector store for RAG / semantic search) ---
QDRANT_URL=http://localhost:6333

# --- Kafka (event streaming: ticket.created, message.sent, ai.suggestion, etc.) ---
KAFKA_BROKERS=localhost:9092

# --- Auth ---
JWT_ACCESS_SECRET=----
JWT_REFRESH_SECRET=------
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Chat widget (public, embedded on third-party sites) ---
WIDGET_JWT_SECRET=------
WIDGET_JWT_TTL=90d


# --- Security: HMAC key for OTPs, email-verification/invitation/tracking tokens ---
# Generate with: openssl rand -base64 48
SECURITY_HASH_SECRET=-------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=supportflow.helpdesk@gmail.com
SMTP_PASS=----
MAIL_FROM=SupportFlow <supportflow.helpdesk@gmail.com>
MAIL_DEV_LOG_ONLY=false

# --- Login OTP 2FA ---
LOGIN_OTP_TTL_SECONDS=300
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email verification ---
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Trusted devices (skip OTP for 30 days after opting in) ---
TRUSTED_DEVICE_TTL_DAYS=30
TRUSTED_DEVICE_COOKIE_NAME=td

# --- Agent invitations ---
INVITATION_TTL_DAYS=7

# --- Gmail OAuth token encryption at rest ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=------

# --- Google OAuth (org-level Gmail inbox connections) ---

GOOGLE_CLIENT_ID=------
GOOGLE_CLIENT_SECRET=---
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/gmail/callback
GMAIL_OAUTH_STATE_TTL_SECONDS=600

# --- Gmail sync (Feature 5) ---
# Bounded fetch used only when a connection has no history checkpoint yet
# (brand new, or one whose checkpoint aged out of Gmail's ~7 day retention
# window). Every sync after that is history-based, not a rescan.
GMAIL_INITIAL_SYNC_LIMIT=20
# How often the background worker polls all active connections.
GMAIL_SYNC_POLL_INTERVAL_SECONDS=120

# --- SLA & automation worker (Features 15/16) ---
SLA_SWEEP_INTERVAL_SECONDS=300
SLA_APPROACHING_WINDOW_MINUTES=30

# --- Attachment storage (Phase 10) ---
# Local-disk by default. Swap in an S3-backed driver later without
# touching call sites — see apps/api/src/lib/storage.ts.
ATTACHMENT_STORAGE_DIR=./storage/attachments

# --- AI provider (Google Gemini) ---
GOOGLE_API_KEY=----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AI_URL=http://localhost:8000
API_PORT=4000
AI_SERVICE_PORT=8000

NODE_ENV=development
