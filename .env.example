 --- Postgres (primary relational store: orgs, users, tickets, billing) ---
# --- Neon PostgreSQL ---
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=-----
POSTGRES_DB=neondb
DATABASE_URL="----"

# --- MongoDB (unstructured: chat transcripts, activity logs, attachments meta) ---
MONGO_USER=surajkumar854000_db_user
MONGO_PASSWORD=---
MONGO_DB=support_saas_docs

MONGO_URL="---"


# --- Redis (cache, sessions, BullMQ job queues, rate limiting) ---
REDIS_PASSWORD=saas_dev_password
REDIS_URL=redis://:saas_dev_password@localhost:6379

# --- Elasticsearch (full-text ticket/article search) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Qdrant (vector store for RAG / semantic search) ---
QDRANT_URL=http://localhost:6333

# --- Kafka (event streaming: ticket.created, message.sent, ai.suggestion, etc.) ---
KAFKA_BROKERS=localhost:9092

# --- Auth ---
JWT_ACCESS_SECRET=---
JWT_REFRESH_SECRET=----
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Chat widget (public, embedded on third-party sites) ---
WIDGET_JWT_SECRET=----
WIDGET_JWT_TTL=90d


# --- Security: HMAC key for OTPs, email-verification/invitation/tracking tokens ---
# Generate with: openssl rand -base64 48
SECURITY_HASH_SECRET=----

# --- Outbound mail (login OTP codes, email verification, ticket notifications) ---
# For local dev with Gmail SMTP: use an App Password, never your real Gmail password.
# Leave SMTP_USER/SMTP_PASS empty to log emails instead of sending them (MAIL_DEV_LOG_ONLY).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=supportflow.helpdesk@gmail.com
SMTP_PASS=----
MAIL_FROM=SupportFlow <supportflow.helpdesk@gmail.com>
MAIL_DEV_LOG_ONLY=false

# --- Login OTP 2FA ---
LOGIN_OTP_TTL_SECONDS=300
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email verification ---
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Trusted devices (skip OTP for 30 days after opting in) ---
TRUSTED_DEVICE_TTL_DAYS=30
TRUSTED_DEVICE_COOKIE_NAME=td

# --- Agent invitations ---
INVITATION_TTL_DAYS=7

# --- Gmail OAuth token encryption at rest ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=X8K2M9Q1P4R7T6Y3U5W2A9B8C1D4E7F6

# --- Google OAuth (org-level Gmail inbox connections) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# The redirect URI below must be registered exactly as-is on that OAuth client.
GOOGLE_CLIENT_ID=---
GOOGLE_CLIENT_SECRET=----
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/gmail/callback
GMAIL_OAUTH_STATE_TTL_SECONDS=600

# --- Gmail sync (Feature 5) ---
# Bounded fetch used only when a connection has no history checkpoint yet
# (brand new, or one whose checkpoint aged out of Gmail's ~7 day retention
# window). Every sync after that is history-based, not a rescan.
GMAIL_INITIAL_SYNC_LIMIT=20
# How often the background worker polls all active connections.
GMAIL_SYNC_POLL_INTERVAL_SECONDS=120

# --- SLA & automation worker (Features 15/16) ---
SLA_SWEEP_INTERVAL_SECONDS=300
SLA_APPROACHING_WINDOW_MINUTES=30

# --- Attachment storage (Phase 10) ---
# Local-disk by default. Swap in an S3-backed driver later without
# touching call sites — see apps/api/src/lib/storage.ts.
ATTACHMENT_STORAGE_DIR=./storage/attachments

# --- AI provider (Google Gemini) ---
GOOGLE_API_KEY=----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8000

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AI_URL=http://localhost:8000
API_PORT=4000
AI_SERVICE_PORT=8000

NODE_ENV=development


# --- SemantiCache (apps/semantic-cache) ---
# Java semantic cache in front of the AI service's RAG/LLM path. Disabling
# it (or stopping the container) makes the AI service fall back to the
# normal RAG pipeline — it is never a hard dependency.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_URL=http://localhost:8081
SEMANTIC_CACHE_PORT=8081
# Shared service-to-service token sent as X-Internal-Token. Generate a real
# one for anything but local dev: openssl rand -hex 32
SEMANTIC_CACHE_SERVICE_TOKEN=saas_dev_internal_token
SEMANTIC_CACHE_TIMEOUT_MS=3000

# L1 (in-process LRU) size and entry lifetime.
CACHE_L1_CAPACITY=10000
CACHE_TTL_SECONDS=3600
CACHE_MAX_RESPONSE_SIZE=32768
# Must match QDRANT_VECTOR_SIZE — the cache stores the embedding the AI
# service already computed, so the dimensions have to line up.
CACHE_EMBEDDING_DIMENSION=3072

# Precision/hit-rate trade-off. Higher threshold = fewer wrong reuses and a
# lower hit rate. A false positive returns a wrong support answer, so this
# is deliberately conservative.
SEMANTIC_SIMILARITY_THRESHOLD=0.92
# Borderline band [judge, similarity) is only reused if the optional LLM
# judge approves. Off by default so the cache never adds an LLM call.
SEMANTIC_JUDGE_THRESHOLD=0.88
SEMANTIC_JUDGE_ENABLED=false

# Random-hyperplane LSH: more tables = better recall, more memory.
LSH_TABLES=8
LSH_HYPERPLANES=12
LSH_MAX_CANDIDATES=64

# Bloom filter gate. Sized from these two values; false positives are
# expected and harmless (they only cost a lookup), false negatives are not
# possible for entries this instance stored.
BLOOM_EXPECTED_INSERTIONS=100000
BLOOM_FALSE_POSITIVE_RATE=0.01
# Set false in multi-instance deployments if you would rather pay the Redis
# round-trip than miss an exact hit written by a peer instance.
BLOOM_GATES_L2=true

# Coalescing / scheduling. REQUEST_TIMEOUT_MS is how long a coalesced
# waiter parks on the owner's result; keep it below the servlet async
# timeout (SEMANTIC_CACHE_REQUEST_TIMEOUT_MS, default 50000).
REQUEST_TIMEOUT_MS=45000
SCHEDULER_MAX_CONCURRENT=16
MAX_QUEUE_SIZE=256

# Cost accounting is reported only from these configured values — there are
# no built-in prices. Leave at 0 to report avoided calls without money.
LLM_COST_PER_CALL=0
LLM_ESTIMATED_TOKENS_PER_CALL=0
