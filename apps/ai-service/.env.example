ENVIRONMENT=development
AI_SERVICE_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

GOOGLE_API_KEY=---
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001


QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_articles
QDRANT_VECTOR_SIZE=3072


RETRIEVAL_TOP_K=4
MIN_CONFIDENCE_SIMILARITY=0.55 
# --- SemantiCache (Java semantic response cache in front of RAG + LLM) ---
# Turning this off, or the service being unreachable, leaves the RAG pipeline exactly as it was
# before the cache existed.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_URL=http://localhost:8081
# Must match SEMANTIC_CACHE_SERVICE_TOKEN in the Java service.
SEMANTIC_CACHE_SERVICE_TOKEN=
SEMANTIC_CACHE_CONNECT_TIMEOUT_SECONDS=1.0
SEMANTIC_CACHE_READ_TIMEOUT_SECONDS=50.0
# Bump when the provider changes a model behind a stable name.
SEMANTIC_CACHE_MODEL_VERSION=1
# Optional LLM second opinion on borderline matches. Off by default: it trades a full
# retrieval + generation for one cheap call, which only pays off if the judge really is cheap.
SEMANTIC_JUDGE_ENABLED=false
